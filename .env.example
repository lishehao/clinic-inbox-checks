# Copy this file to .env and fill in ONE endpoint. .env is ignored by git.
# Any OpenAI-compatible /chat/completions endpoint works.

# OpenRouter, GPT-6 Luna (cheap and fast)
CIC_BASE_URL=https://openrouter.ai/api/v1
CIC_MODEL=openai/gpt-6-luna
CIC_API_KEY=

# Alibaba Cloud Model Studio (Qwen), OpenAI-compatible mode. Use the base URL of your
# account's region and the exact model id from its model list.
# CIC_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# CIC_MODEL=<qwen flash model id>
# CIC_API_KEY=

# OpenAI directly, or a gateway that speaks the same API
# CIC_BASE_URL=https://api.openai.com/v1
# CIC_MODEL=<model id>
# CIC_API_KEY=

# Optional
# CIC_TEMPERATURE=0.7     # set to none if the model rejects temperature
# CIC_JSON_MODE=1         # ask for JSON output when the endpoint supports it
