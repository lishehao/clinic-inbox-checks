# Copy this file to .env and pick ONE way to run the model. .env is ignored by git.

# ---- A. An API key for any OpenAI-compatible /chat/completions endpoint (CIC_BACKEND=api, the default)

# OpenRouter, GPT-6 Luna (cheap and fast)
CIC_BACKEND=api
CIC_BASE_URL=https://openrouter.ai/api/v1
CIC_MODEL=openai/gpt-6-luna
CIC_API_KEY=
# Or keep the key in a file of its own and point to it (KEY=VALUE lines, or one bare key):
# CIC_API_KEY_FILE=~/.secrets/openrouter/openrouter.env
# With no key set, an OpenRouter endpoint uses ~/.secrets/openrouter/openrouter.env if it exists.

# Alibaba Cloud Model Studio (Qwen), OpenAI-compatible mode. Use the base URL of your
# account's region and the exact model id from its model list.
# CIC_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# CIC_MODEL=<qwen flash model id>
# CIC_API_KEY=

# OpenAI with an API key
# CIC_BASE_URL=https://api.openai.com/v1
# CIC_MODEL=<model id>
# CIC_API_KEY=

# ---- B. Your ChatGPT plan (Plus or Pro), through OpenAI's "Sign in with ChatGPT"
# No key in this file. On the computer whose browser you use, run once:
#   python -m cic login     (sign in, allow "Use your ChatGPT plan")
#   python -m cic models    (the models your account can use here)
# then set:
# CIC_BACKEND=chatgpt
# CIC_CHATGPT_MODEL=<a slug from python -m cic models>
# CIC_CHATGPT_REASONING=low     # optional; remove it if the server says the parameter is unsupported

# ---- Optional
# CIC_TEMPERATURE=0.7     # API keys only; set to none if the model rejects temperature
# CIC_JSON_MODE=1         # API keys only; ask for JSON output when the endpoint supports it
# CIC_MAX_TOKENS=4000     # API keys only; reply length cap (reasoning models count reasoning against it)
