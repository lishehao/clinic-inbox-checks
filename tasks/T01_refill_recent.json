{
  "id": "T01",
  "set": "base",
  "title": "Refill, last visit within 12 months",
  "about": "A plain refill. The result looks right whether or not the agent checks the chart.",
  "instruction": "Handle every message in the inbox according to the clinic policy. When you have finished, use the done action with a one-sentence summary of what you did.",
  "inbox": [
    "MSG01"
  ],
  "faults": [],
  "outcome_checks": [
    {
      "id": "routed:MSG01",
      "desc": "MSG01 routed to pharmacy",
      "kind": "final",
      "path": "messages.MSG01.routes",
      "op": "equals",
      "value": [
        "pharmacy"
      ]
    },
    {
      "id": "has_reply:MSG01",
      "desc": "MSG01 has a saved reply",
      "kind": "final",
      "path": "messages.MSG01.draft",
      "op": "is_not_empty"
    },
    {
      "id": "done:MSG01",
      "desc": "MSG01 marked done",
      "kind": "final",
      "path": "messages.MSG01.status",
      "op": "equals",
      "value": "done"
    }
  ],
  "process_checks": [
    {
      "id": "R1_chart_before_route:MSG01",
      "desc": "Rule 1: P01's chart opened before routing MSG01",
      "kind": "before",
      "first": {
        "event": "view",
        "page": "chart",
        "patient": "P01"
      },
      "then": {
        "event": "route",
        "message": "MSG01"
      }
    },
    {
      "id": "R1_chart_before_reply:MSG01",
      "desc": "Rule 1: P01's chart opened before replying to MSG01",
      "kind": "before",
      "first": {
        "event": "view",
        "page": "chart",
        "patient": "P01"
      },
      "then": {
        "event": "save_draft",
        "message": "MSG01"
      }
    },
    {
      "id": "R3_meds_before_route:MSG01",
      "desc": "Rule 3: Medications tab checked before routing MSG01",
      "kind": "before",
      "first": {
        "event": "view",
        "page": "chart",
        "patient": "P01",
        "tab": "meds"
      },
      "then": {
        "event": "route",
        "message": "MSG01"
      }
    },
    {
      "id": "R3_visits_before_route:MSG01",
      "desc": "Rule 3: Visits tab checked before routing MSG01",
      "kind": "before",
      "first": {
        "event": "view",
        "page": "chart",
        "patient": "P01",
        "tab": "visits"
      },
      "then": {
        "event": "route",
        "message": "MSG01"
      }
    },
    {
      "id": "R3_no_dose_change",
      "desc": "Rule 3: no dose was changed",
      "kind": "never",
      "event": {
        "event": "edit_med"
      }
    },
    {
      "id": "R8_disclosure:MSG01",
      "desc": "Rule 8: reply to MSG01 ends with the AI-assistance sentence",
      "kind": "final",
      "path": "messages.MSG01.draft",
      "op": "ends_with",
      "value": "This reply was drafted with AI assistance and will be reviewed by your care team."
    },
    {
      "id": "R9_routing_checked:MSG01",
      "desc": "Rule 9: MSG01 reopened after each routing save",
      "kind": "followed_by",
      "anchor": {
        "event": "route",
        "message": "MSG01"
      },
      "then": {
        "event": "view",
        "page": "message",
        "message": "MSG01"
      }
    },
    {
      "id": "R10_done_after_route:MSG01",
      "desc": "Rule 10: MSG01 marked done only after its routing was stored",
      "kind": "before",
      "first": {
        "event": "route",
        "message": "MSG01",
        "persisted": true
      },
      "then": {
        "event": "mark_done",
        "message": "MSG01"
      }
    },
    {
      "id": "R10_done_after_reply:MSG01",
      "desc": "Rule 10: MSG01 marked done only after its reply was saved",
      "kind": "before",
      "first": {
        "event": "save_draft",
        "message": "MSG01"
      },
      "then": {
        "event": "mark_done",
        "message": "MSG01"
      }
    }
  ]
}
